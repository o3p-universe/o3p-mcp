<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 18: groups hang on a module category; the user form shows the
         two groups as one selection because Editor implies User. -->
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP</field>
        <field name="sequence">90</field>
        <field name="description">Signing in to the MCP server with an Odoo account.</field>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_mcp"/>
        <field name="comment">Signs in to the MCP server with the okf.read, odoo.read and odoo.sql scopes.</field>
    </record>

    <record id="group_mcp_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_mcp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_mcp_user'))]"/>
        <field name="comment">Signs in to the MCP server with the User scopes plus okf.write.</field>
    </record>
</odoo>
