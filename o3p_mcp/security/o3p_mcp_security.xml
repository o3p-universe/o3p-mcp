<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="description">Signing in to the MCP server with an Odoo account.</field>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="comment">Signs in to the MCP server with the okf.read and odoo.read scopes.</field>
    </record>

    <record id="group_mcp_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_mcp_user'))]"/>
        <field name="comment">Signs in to the MCP server with the User scopes plus okf.write.</field>
    </record>

    <!-- SQL is a right of its own: a privilege with one group, shown on the
         user form as a choice of its own. It does not imply MCP / User, so
         that removing MCP / User ends every MCP right in one step. -->
    <record id="res_groups_privilege_mcp_sql" model="res.groups.privilege">
        <field name="name">MCP SQL</field>
        <field name="sequence">91</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="description">Running read-only SQL through the MCP server.</field>
    </record>

    <record id="group_mcp_sql" model="res.groups">
        <field name="name">Allowed</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp_sql"/>
        <field name="comment">With MCP / User, adds the odoo.sql scope: read-only SQL on the rows the user may read.</field>
    </record>

    <!-- Changing records is a right of its own, like SQL: it adds odoo.write
         for users who hold MCP / User and grants nothing without it. -->
    <record id="res_groups_privilege_mcp_records" model="res.groups.privilege">
        <field name="name">MCP records</field>
        <field name="sequence">92</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="description">Creating and changing Odoo records through the MCP server.</field>
    </record>

    <record id="group_mcp_record_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp_records"/>
        <field name="comment">With MCP / User, adds the odoo.write scope: creating and changing records of the models opened in the settings, with the user's own rights.</field>
    </record>
</odoo>
