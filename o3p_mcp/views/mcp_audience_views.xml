<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_audience_view_list" model="ir.ui.view">
        <field name="name">o3p.mcp.audience.list</field>
        <field name="model">o3p.mcp.audience</field>
        <field name="arch" type="xml">
            <list string="MCP Audiences" default_order="code">
                <field name="code"/>
                <field name="name"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="user_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mcp_audience_view_form" model="ir.ui.view">
        <field name="name">o3p.mcp.audience.form</field>
        <field name="model">o3p.mcp.audience</field>
        <field name="arch" type="xml">
            <form string="MCP Audience">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Human resources"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="hr"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_count"/>
                        </group>
                    </group>
                    <group string="Groups">
                        <field name="group_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_audience_view_search" model="ir.ui.view">
        <field name="name">o3p.mcp.audience.search</field>
        <field name="model">o3p.mcp.audience</field>
        <field name="arch" type="xml">
            <search string="MCP Audiences">
                <field name="name"/>
                <field name="code"/>
                <field name="group_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mcp_audience" model="ir.actions.act_window">
        <field name="name">MCP Audiences</field>
        <field name="res_model">o3p.mcp.audience</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an audience</p>
            <p>An audience is a named set of Odoo groups. The MCP server serves each knowledge bundle to the audiences its configuration names.</p>
        </field>
    </record>

    <menuitem id="menu_o3p_mcp_audience"
              name="Audiences"
              parent="menu_o3p_mcp_technical"
              action="action_mcp_audience"
              groups="base.group_system"
              sequence="15"/>
</odoo>
