<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_api_log_view_list" model="ir.ui.view">
        <field name="name">o3p.mcp.api.log.list</field>
        <field name="model">o3p.mcp.api.log</field>
        <field name="arch" type="xml">
            <list string="MCP API Calls" create="0" edit="0" delete="0"
                  decoration-danger="status &gt;= 400">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="client_id" optional="show"/>
                <field name="op"/>
                <field name="action" optional="show"/>
                <field name="model"/>
                <field name="tables" optional="hide"/>
                <field name="record_ids" optional="show"/>
                <field name="field_names" optional="hide"/>
                <field name="status"/>
                <field name="error" optional="show"/>
                <field name="row_count"/>
                <field name="duration_ms" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mcp_api_log_view_search" model="ir.ui.view">
        <field name="name">o3p.mcp.api.log.search</field>
        <field name="model">o3p.mcp.api.log</field>
        <field name="arch" type="xml">
            <search string="MCP API Calls">
                <field name="user_id"/>
                <field name="model"/>
                <field name="tables"/>
                <field name="op"/>
                <field name="action"/>
                <field name="error"/>
                <filter name="failed" string="Failed" domain="[('status', '&gt;=', 400)]"/>
                <filter name="writes" string="Writes" domain="[('op', 'in', ('create', 'update'))]"/>
                <filter name="actions" string="Actions run" domain="[('op', '=', 'run_action')]"/>
                <separator/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                <filter name="group_op" string="Operation" context="{'group_by': 'op'}"/>
                <filter name="group_action" string="Exposed action" context="{'group_by': 'action'}"/>
            </search>
        </field>
    </record>

    <record id="action_mcp_api_log" model="ir.actions.act_window">
        <field name="name">MCP API Calls</field>
        <field name="res_model">o3p.mcp.api.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mcp_api_log_view_search"/>
    </record>

    <menuitem id="menu_o3p_mcp_api_log"
              name="API Calls"
              parent="menu_o3p_mcp_technical"
              action="action_mcp_api_log"
              groups="base.group_system"
              sequence="30"/>
</odoo>
